# Copy to .env and fill in. .env is ignored by Git.

# Gemini (optional). Without a key the app uses offline hash embeddings and
# returns safe fallbacks instead of model answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# auto = Gemini embeddings when a key is set, otherwise hash; hash = always offline
EMBEDDING_PROVIDER=auto

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Backend-only local development (Docker Compose sets its own DATABASE_URL)
DATABASE_URL=sqlite:///./supportflow.db
